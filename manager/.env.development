# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 前端开发服务器端口
VITE_PORT = 3006

# API 请求基础路径。开发必须留空，让请求走当前页面同源的 Vite /api 代理。
# 写成 http://localhost:8080 会跨源：页面在 :3006，refresh_token Cookie（Path=/api, SameSite=Lax）
# 在 127.0.0.1 与 localhost 混用时带不上，浏览器一刷新 accessToken（仅内存）丢失就会掉登录。
VITE_API_URL =

# 代理目标（后端 origin，不要带 /api 后缀；前端请求路径已包含 /api）
VITE_API_PROXY_URL = http://localhost:8080

# 是否携带凭证（Cookie）
VITE_WITH_CREDENTIALS = true

# Delete console
VITE_DROP_CONSOLE = false

# Page Agent（DeepSeek）。API Key 只写在 .env.local，不要写在本文件。
VITE_PAGE_AGENT_MODEL = deepseek-v4-pro
VITE_PAGE_AGENT_BASE_URL = /deepseek-api
