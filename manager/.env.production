# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀
VITE_API_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 是否携带凭证（Cookie）
VITE_WITH_CREDENTIALS = true

# Delete console
VITE_DROP_CONSOLE = true

# Page Agent（生产环境需要后端或网关转发 DeepSeek，避免浏览器 CORS）
# API Key 不要写在本文件，用服务器环境变量或 .env.production.local
VITE_PAGE_AGENT_MODEL = deepseek-v4-pro
VITE_PAGE_AGENT_BASE_URL = /deepseek-api
